{
  "schemaVersion": 1,
  "versionPolicy": {
    "name": "SemVer 2.0 without build metadata",
    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
  },
  "targets": [
    {
      "id": "dotnet/issuer",
      "ecosystem": "dotnet",
      "role": "issuer",
      "publicRepository": "Verifiabl/verifiabl-dotnet",
      "changelog": "packages/Verifiabl.Issuer/CHANGELOG.md",
      "tags": {
        "privatePrefix": "dotnet/issuer/v",
        "publicPrefix": "issuer/v"
      },
      "packages": [
        {
          "id": "Verifiabl.Issuer",
          "versionSource": {
            "kind": "xml",
            "path": "packages/Verifiabl.Issuer/src/Verifiabl.csproj",
            "versionElement": "Version",
            "packageIdElement": "PackageId"
          }
        },
        {
          "id": "Verifiabl.Issuer.Extensions.DependencyInjection",
          "versionSource": {
            "kind": "xml",
            "path": "packages/Verifiabl.Issuer.Extensions.DependencyInjection/src/Verifiabl.Extensions.DependencyInjection.csproj",
            "versionElement": "Version",
            "packageIdElement": "PackageId"
          }
        }
      ],
      "coupledVersionGroups": [
        [
          "Verifiabl.Issuer",
          "Verifiabl.Issuer.Extensions.DependencyInjection"
        ]
      ],
      "packCommands": [
        {
          "run": [
            "dotnet",
            "pack",
            "packages/Verifiabl.Issuer/src/Verifiabl.csproj",
            "--configuration",
            "Release",
            "--no-build",
            "--output",
            "artifacts",
            "-p:Version={version}"
          ]
        },
        {
          "run": [
            "dotnet",
            "pack",
            "packages/Verifiabl.Issuer.Extensions.DependencyInjection/src/Verifiabl.Extensions.DependencyInjection.csproj",
            "--configuration",
            "Release",
            "--no-build",
            "--output",
            "artifacts",
            "-p:Version={version}"
          ]
        }
      ]
    },
    {
      "id": "dotnet/verifier",
      "ecosystem": "dotnet",
      "role": "verifier",
      "publicRepository": "Verifiabl/verifiabl-dotnet",
      "changelog": "packages/Verifiabl.Verifier/CHANGELOG.md",
      "tags": {
        "privatePrefix": "dotnet/verifier/v",
        "publicPrefix": "verifier/v"
      },
      "packages": [
        {
          "id": "Verifiabl.Verifier",
          "versionSource": {
            "kind": "xml",
            "path": "packages/Verifiabl.Verifier/src/Verifiabl.Verifier.csproj",
            "versionElement": "Version",
            "packageIdElement": "PackageId"
          }
        }
      ],
      "coupledVersionGroups": [],
      "packCommands": [
        {
          "run": [
            "dotnet",
            "pack",
            "packages/Verifiabl.Verifier/src/Verifiabl.Verifier.csproj",
            "--configuration",
            "Release",
            "--no-build",
            "--output",
            "artifacts",
            "-p:Version={version}"
          ]
        }
      ]
    }
  ]
}
