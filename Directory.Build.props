<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Fail restore on known-vulnerable dependencies, including transitive ones. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Normalise embedded paths so CI builds are reproducible. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Strong-name every assembly with a shared key so the package has a stable
    identity for enterprise consumers (some locked-down .NET Framework hosts
    require strong-named dependencies). Strong naming is an identity, not a
    security boundary, so the key is committed deliberately.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)verifiabl.snk</AssemblyOriginatorKeyFile>
    <!-- Public key of verifiabl.snk, for strong-named InternalsVisibleTo. -->
    <VerifiablPublicKey></VerifiablPublicKey>
  </PropertyGroup>

</Project>
