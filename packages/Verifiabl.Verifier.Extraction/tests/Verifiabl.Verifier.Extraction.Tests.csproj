<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- net472 exercises the .NET Framework build; it can only run on Windows. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' or '$(BuildNetFrameworkTests)' == 'true'">net8.0;net10.0;net472</TargetFrameworks>
    <!-- Including net472 changes the target set and requires its own lockfile. -->
    <NuGetLockFilePath Condition="'$(OS)' == 'Windows_NT' or '$(BuildNetFrameworkTests)' == 'true'">packages.windows.lock.json</NuGetLockFilePath>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Test-only: ZXing.Net writes QR codes, SkiaSharp encodes image files and PdfPig's writer builds the fixture PDFs. The package reads them all in its sandbox. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="PdfPig" Version="0.1.17-alpha-202611030024-c46d2" />
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.155.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ExtractionFixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="StandIns\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Verifiabl.Verifier.Extraction.csproj" />
    <!-- Test-only: real issuer badges and payloads to embed. -->
    <ProjectReference Include="..\..\Verifiabl.Issuer\src\Verifiabl.csproj" />
  </ItemGroup>

</Project>
