<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' or '$(BuildNetFrameworkTests)' == 'true'">net8.0;net10.0;net472</TargetFrameworks>
    <NuGetLockFilePath Condition="'$(OS)' == 'Windows_NT' or '$(BuildNetFrameworkTests)' == 'true'">packages.windows.lock.json</NuGetLockFilePath>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(VerifiablVerifierVersion)' == ''">
    <ProjectReference Include="../src/Verifiabl.Verifier.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(VerifiablVerifierVersion)' != ''">
    <PackageReference Include="Verifiabl.Verifier" Version="$(VerifiablVerifierVersion)" />
  </ItemGroup>

</Project>
