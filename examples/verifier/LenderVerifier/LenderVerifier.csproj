<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <!-- Set VerifiablVerifierVersion to test the locally packed package instead of source. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(VerifiablVerifierVersion)' == ''">
    <ProjectReference Include="../../../packages/Verifiabl.Verifier/src/Verifiabl.Verifier.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(VerifiablVerifierVersion)' != ''">
    <PackageReference Include="Verifiabl.Verifier" Version="$(VerifiablVerifierVersion)" />
  </ItemGroup>

</Project>
