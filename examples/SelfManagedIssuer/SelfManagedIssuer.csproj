<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <!-- Set VerifiablIssuerVersion to test the locally packed package instead of source. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(VerifiablIssuerVersion)' == ''">
    <ProjectReference Include="../../src/Verifiabl/Verifiabl.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(VerifiablIssuerVersion)' != ''">
    <PackageReference Include="Verifiabl.Issuer" Version="$(VerifiablIssuerVersion)" />
  </ItemGroup>

</Project>
